      "alters": [
        {
          "control-id": "ac-3.2",
          "adds": [
            {
              "position": "ending",
              "parts": [
                {
                  "id": "ac-3.2_cccs_note",
                  "name": "cccs-profile-note",
                  "ns": "https://northfleetsecurity.ca/ns/oscal/cccs",
                  "prose": "Organizations must assess which administrative actions are capable of creating the entire available Injury. These actions are candidates for dual authorization."
                }
              ]
            }
          ]
        },
        {
          "control-id": "ac-3.4",
          "adds": [
            {
              "position": "ending",
              "parts": [
                {
                  "id": "ac-3.4_cccs_note",
                  "name": "cccs-profile-note",
                  "ns": "https://northfleetsecurity.ca/ns/oscal/cccs",
                  "prose": "Control enhancement (04) clarifies the Access Enforcement security control by detailing the policy that should be used for access enforcement to Protected B information. That is, while the system may be authorized to process PB, not all information will necessarily be PB. Therefore, DAC will be used to establish and enforce access controls over PB information to “need to know.” Examples of DAC include Windows groups (at the file object level) and document management systems that allow document access permissions to be modified by the owner."
                }
              ]
            }
          ]
        },
        {
          "control-id": "ac-16",
          "adds": [
            {
              "position": "ending",
              "parts": [
                {
                  "id": "ac-16_cccs_note",
                  "name": "cccs-profile-note",
                  "ns": "https://northfleetsecurity.ca/ns/oscal/cccs",
                  "prose": "In the context of this profile, the objective of this control is to achieve consistent labeling of Protected B material to the maximum extent supported by available, automated mechanisms (for example, email system enforcing classification labels). Since not all information on the system will be sensitive, labeling will help prevent the accidental distribution of Protected B information by providing filter mechanisms with a differentiator."
                }
              ]
            }
          ]
        },
        {
          "control-id": "ac-21.400",
          "adds": [
            {
              "position": "ending",
              "parts": [
                {
                  "id": "ac-21.400_cccs_note",
                  "name": "cccs-profile-note",
                  "ns": "https://northfleetsecurity.ca/ns/oscal/cccs",
                  "prose": "GC specific"
                }
              ]
            }
          ]
        },
        {
          "control-id": "ac-21.401",
          "adds": [
            {
              "position": "ending",
              "parts": [
                {
                  "id": "ac-21.401_cccs_note",
                  "name": "cccs-profile-note",
                  "ns": "https://northfleetsecurity.ca/ns/oscal/cccs",
                  "prose": "GC specific"
                }
              ]
            }
          ]
        },
        {
          "control-id": "ia-12.5",
          "adds": [
            {
              "position": "ending",
              "parts": [
                {
                  "id": "ia-12.5_cccs_note",
                  "name": "cccs-profile-note",
                  "ns": "https://northfleetsecurity.ca/ns/oscal/cccs",
                  "prose": "This control is recommended for users external to the organization."
                }
              ]
            }
          ]
        },
        {
          "control-id": "pe-3",
          "adds": [
            {
              "position": "ending",
              "parts": [
                {
                  "id": "pe-3_cccs_note",
                  "name": "cccs-profile-note",
                  "ns": "https://northfleetsecurity.ca/ns/oscal/cccs",
                  "prose": "According to the TBS Policy on Government Security and RCMP GCPSG-006 Access Management Guide, access to sensitive information and areas must be limited. A physical Operations Zone is the minimum required where sensitive GC information is processed or stored. A TRA must be performed to ensure the appropriate level of physical security to protect Protected B information and information systems processing and storing PB data. This zone is an area where access is limited to personnel who work there and to properly-escorted visitors by an employee with a valid reliability status; it must be indicated by a recognizable perimeter and monitored periodically."
                }
              ]
            }
          ]
        },
        {
          "control-id": "pe-3.400",
          "adds": [
            {
              "position": "ending",
              "parts": [
                {
                  "id": "pe-3.400_cccs_note",
                  "name": "cccs-profile-note",
                  "ns": "https://northfleetsecurity.ca/ns/oscal/cccs",
                  "prose": "GC specific."
                }
              ]
            }
          ]
        },
        {
          "control-id": "pe-13.400",
          "adds": [
            {
              "position": "ending",
              "parts": [
                {
