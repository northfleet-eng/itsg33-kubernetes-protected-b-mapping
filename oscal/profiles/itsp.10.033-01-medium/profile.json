        },
        {
          "control-id": "sc-29",
          "adds": [
            {
              "position": "ending",
              "parts": [
                {
                  "id": "sc-29_cccs_note",
                  "name": "cccs-profile-note",
                  "ns": "https://northfleetsecurity.ca/ns/oscal/cccs",
                  "prose": "In order to protect PBMM against Td4 compromise using a single unknown system flaw (a 0-Day), disaggregate the business functions between systems that do not share a single-point-of-failure. For example, host one line-of-business database in Windows, and a different line-of-business database in Linux."
                }
              ]
            }
          ]
        }
      ]
