        {
          "control-id": "pe-400.2",
          "adds": [
            {
              "position": "ending",
              "parts": [
                {
                  "id": "pe-400.2_cccs_note",
                  "name": "cccs-profile-note",
                  "ns": "https://northfleetsecurity.ca/ns/oscal/cccs",
